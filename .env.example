# ---- App ----
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ----
# SQLite by default; switch to Postgres for production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/studymate
DATABASE_URL=sqlite:///./data/studymate.db

# ---- LLM provider ----
# primary provider + automatic fallback to any others that have keys
# gemini (free: https://aistudio.google.com/apikey)
# mistral (free: https://console.mistral.ai)
# groq   (free: https://console.groq.com/keys)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash      # optional overrides
# MISTRAL_MODEL=mistral-small-latest

# ---- Google OAuth (optional; demo login is used when empty) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000