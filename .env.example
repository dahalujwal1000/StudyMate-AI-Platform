# ---- App ----
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ----
# SQLite by default; switch to Postgres for production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/studymate
DATABASE_URL=sqlite:///./data/studymate.db

# ---- LLM provider ----
# gemini (default, free tier from https://aistudio.google.com/apikey)
# groq  (free tier from https://console.groq.com/keys)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Google OAuth (optional; demo login is used when empty) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000